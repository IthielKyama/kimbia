# ==============================================================================
# KIMBIA BACKEND ENVIRONMENT VARIABLES (RENDER / PRODUCTION)
# ==============================================================================

# Server Port (Render sets this automatically, default 8081 for local)
PORT=10000

# Neon PostgreSQL Database Configuration
# Option A (Pooler / PgBouncer - note prepareThreshold=0):
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-curly-base-zani8k86-pooler.c-2.eu-west-2.aws.neon.tech:5432/neondb?sslmode=require&prepareThreshold=0
# Option B (Direct connection - recommended for Spring Boot HikariCP):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-curly-base-zani8k86.c-2.eu-west-2.aws.neon.tech:5432/neondb?sslmode=require

SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD_HERE

# JPA & Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

