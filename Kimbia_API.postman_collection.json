                {
                    "name": "Login (Organizer or Runner)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.token) {",
                                    "        pm.collectionVariables.set('token', jsonData.token);",
                                    "        console.log('Saved token to collection variable: token');",
                                    "    }",
